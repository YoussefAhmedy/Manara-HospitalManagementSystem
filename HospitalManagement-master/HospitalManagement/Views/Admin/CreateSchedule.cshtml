@using Hospital.DAL.Entities.OwnedTypes
@model CreateScheduleVM
@{
    ViewData["Title"] = "Configure Clinic Schedule";
    ViewData["Subtitle"] = "Assign weekly clinical days and shifts for specialists.";
}

<div class="ws-header">
    <div>
        <span class="pill-tag">Administration &bull; Scheduling</span>
        <h1 class="ws-title">Configure Doctor Schedule</h1>
    </div>
    <a class="btn btn-sm" asp-controller="Admin" asp-action="Index">Back to Operations</a>
</div>

<section class="panel" style="max-width:720px;">
    <div class="panel-head">
        <h2 class="panel-title">Assign Shift &amp; Day</h2>
    </div>
    <div class="panel-body">
        <form asp-action="CreateSchedule" asp-controller="Admin" method="post" class="form-grid">
            <div asp-validation-summary="All" class="text-danger form-field full"></div>

            <div class="form-field">
                <label class="form-label" asp-for="DoctorId">Physician</label>
                <select asp-for="DoctorId" class="select" required>
                    <option value="">Select Doctor</option>
                    @if (Model.Doctors != null)
                    {
                        foreach (var doc in Model.Doctors)
                        {
                            <option value="@doc.Id">Dr. @doc.FirstName @doc.LastName</option>
                        }
                    }
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label class="form-label" asp-for="Day">Clinic Day</label>
                <select asp-for="Day" class="select" required>
                    <option value="">Select Day</option>
                    <option value="@DayOfWeek.Sunday">Sunday</option>
                    <option value="@DayOfWeek.Monday">Monday</option>
                    <option value="@DayOfWeek.Tuesday">Tuesday</option>
                    <option value="@DayOfWeek.Wednesday">Wednesday</option>
                    <option value="@DayOfWeek.Thursday">Thursday</option>
                    <option value="@DayOfWeek.Friday">Friday</option>
                    <option value="@DayOfWeek.Saturday">Saturday</option>
                </select>
                <span asp-validation-for="Day" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label class="form-label" asp-for="ShiftId">Shift Window</label>
                <select asp-for="ShiftId" class="select" required>
                    <option value="">Select Shift</option>
                    @if (Model.Shifts != null)
                    {
                        foreach (var shif in Model.Shifts)
                        {
                            <option value="@shif.ShiftId">@shif.ShiftType (@shif.StartTIme - @shif.EndTIme)</option>
                        }
                    }
                </select>
                <span asp-validation-for="ShiftId" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label class="form-label" asp-for="Status">Availability Status</label>
                <select asp-for="Status" class="select" required>
                    <option value="">Select Status</option>
                    <option value="0">Assigned</option>
                    <option value="1">Unavailable</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-field full" style="margin-top:8px;">
                <button class="btn btn-primary" type="submit" style="width:100%;">Save Clinic Schedule</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
