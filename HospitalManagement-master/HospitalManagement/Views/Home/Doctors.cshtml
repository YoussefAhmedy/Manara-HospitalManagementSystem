@using Hospital.BLL.ModelVM
@model MainVm
@{
    ViewData["Title"] = "Our Specialist Physicians & Medical Faculty";
    ViewData["Description"] = "Meet all board-certified consultants across MANARA Medical Complex departments.";
    var selectedDept = ViewBag.SelectedDept as string;
    var totalFacultyCount = Model.Departments.Sum(d => d.Doctors.Count);
}

<section class="doctors-band" style="padding-top:48px;padding-bottom:68px;">
    <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;margin-bottom:24px;">
            <div>
                <div class="editorial-kicker">Board-Certified Consultants</div>
                <h1 class="serif-display" style="font-size:38px;margin-top:8px;margin-bottom:6px;">
                    @(string.IsNullOrWhiteSpace(selectedDept) ? $"All {totalFacultyCount} Specialist Physicians" : $"{selectedDept} Specialists")
                </h1>
                <p style="color:var(--slate);max-width:660px;">
                    Every physician features transparent Egyptian Pounds (EGP) consultation pricing and discounted returning follow-up consultations.
                </p>
            </div>
            @if (!string.IsNullOrWhiteSpace(selectedDept))
            {
                <a class="btn btn-outline btn-sm" asp-controller="Home" asp-action="Doctors" style="text-decoration:none;">Show All Departments</a>
            }
        </div>

        <!-- Department Quick Filter Buttons -->
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px;">
            <a class="btn @(string.IsNullOrWhiteSpace(selectedDept) ? "btn-navy" : "btn-outline") btn-xs" asp-controller="Home" asp-action="Doctors" style="text-decoration:none;">All (@totalFacultyCount)</a>
            @foreach (var dept in Model.Departments)
            {
                var isAct = string.Equals(selectedDept, dept.Name, StringComparison.OrdinalIgnoreCase);
                <a class="btn @(isAct ? "btn-navy" : "btn-outline") btn-xs" asp-controller="Home" asp-action="Doctors" asp-route-dept="@dept.Name" style="text-decoration:none;">@dept.Name (@dept.Doctors.Count)</a>
            }
        </div>

        <div class="doc-grid">
            @foreach (var doc in Model.Doctors)
            {
                var isFollowUp = Model.FollowUpEligibleDoctorIds.Contains(doc.Id);
                var circleId = $"dirSeal_{doc.Id.Replace("-", "")}";
                var imgFile = string.IsNullOrWhiteSpace(doc.Image) ? "doc-salma.jpg" : doc.Image;
                var emblemIcon = (doc.DepartmentName ?? "") switch
                {
                    "Cardiology" => "heart",
                    "Neurology" => "activity",
                    "Clinical Laboratory" => "flask",
                    "Radiology & Imaging" => "scan",
                    _ => "award"
                };

                <article class="doc-card @(doc.IsTopRated ? "top-rated" : "")" style="border-radius:14px;overflow:hidden;">
                    <div class="doc-img-wrap">
                        <img src="@Url.Content("~/images/doctors/" + imgFile)" alt="Dr. @doc.FirstName @doc.LastName" class="doc-img" />

                        @if (doc.IsTopRated)
                        {
                            <span class="doc-top-badge">
                                <partial name="_Icon" model="@("star")" />
                                <span>Top Rated</span>
                            </span>
                        }

                        <div class="doc-seal-badge" aria-hidden="true">
                            <svg class="doc-seal-svg" viewBox="0 0 100 100">
                                <defs>
                                    <path id="@circleId" d="M 50, 50 m -36, 0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0" />
                                </defs>
                                <text class="doc-seal-text">
                                    <textPath href="#@circleId" startOffset="0%">@(doc.SealEmblem ?? "MANARA • GUILD SEAL") &bull;</textPath>
                                </text>
                            </svg>
                            <div class="doc-seal-center">
                                <partial name="_Icon" model="@emblemIcon" />
                            </div>
                        </div>
                    </div>

                    <div class="doc-info">
                        <div class="doc-spec">@(doc.DepartmentName ?? doc.SpecializationName)</div>
                        <div class="doc-name">Dr. @doc.FirstName @doc.LastName</div>
                        <div class="doc-meta" style="font-weight:600;color:var(--navy);">@doc.Title</div>
                        <div class="doc-meta" style="font-size:11.5px;">@doc.Credentials &bull; @doc.ClinicRoom &bull; @doc.ExperienceYears yrs exp</div>
                        <p style="font-size:11.5px;color:var(--slate);line-height:1.45;margin:4px 0;">@doc.Bio</p>

                        <div class="doc-rating-row tabular">
                            <span class="doc-star-icon"><partial name="_Icon" model="@("star")" /></span>
                            <span>@doc.Rating.ToString("0.0")</span>
                            <span style="color:var(--slate-light);font-weight:500;">(@doc.ReviewCount reviews)</span>
                        </div>

                        <div class="doc-fee-row tabular">
                            <span class="doc-fee-main">@doc.SessionPrice.ToString("0") EGP</span>
                            <span class="doc-followup-pill">Follow-Up: @doc.FollowUpFee.ToString("0") EGP</span>
                        </div>

                        <button type="button" class="btn btn-navy btn-sm" style="margin-top:auto;width:100%;"
                                data-book-dept="@(doc.DepartmentName ?? doc.SpecializationName)"
                                data-book-dept-id="@doc.DepartmentId"
                                data-book-doc="Dr. @doc.FirstName @doc.LastName"
                                data-book-doc-id="@doc.Id"
                                data-book-fee="@doc.SessionPrice.ToString("0")"
                                data-book-followup="@doc.FollowUpFee.ToString("0")">
                            @(isFollowUp ? $"Book Follow-Up ({doc.FollowUpFee:0} EGP)" : "Book Consultation")
                        </button>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
