@{
    ViewData["Title"] = "Clinical Departments & Diagnostic Units";
    ViewData["Description"] = "Explore all specialized medical and surgical departments at MANARA Hospital.";
}

<section class="services-band" style="padding-top:48px;">
    <div class="container">
        <span class="pill-tag">Clinical Directory</span>
        <h1 class="serif-display services-heading">All Manara Departments &amp; Diagnostic Units</h1>
        <div>
            <div class="service-row">
                <div class="service-code">01 / CARDIOLOGY<div style="margin-top:4px;color:var(--teal);">450 EGP</div></div>
                <div class="service-name">Heart &amp; Vascular Care</div>
                <div class="service-desc">Comprehensive cardiac diagnostics including ECG, echocardiography, hypertension management, and preventive cardiology.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Main Medical Center &bull; Floor 3</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Cardiology">Book Exam</button>
            </div>
            <div class="service-row">
                <div class="service-code">02 / INTERNAL MEDICINE<div style="margin-top:4px;color:var(--teal);">350 EGP</div></div>
                <div class="service-name">Primary &amp; Chronic Care</div>
                <div class="service-desc">Holistic adult medicine covering metabolic screening, diabetes, thyroid care, and executive health assessments.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Main Medical Center &bull; Floor 2</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Internal Medicine">Book Exam</button>
            </div>
            <div class="service-row">
                <div class="service-code">03 / ORTHOPEDICS<div style="margin-top:4px;color:var(--teal);">400 EGP</div></div>
                <div class="service-name">Joint &amp; Spine Surgery</div>
                <div class="service-desc">Sports injury recovery, minimally invasive arthroscopy, fracture stabilization, and post-operative rehabilitation.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Main Medical Center &bull; Floor 1</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Orthopedics">Book Exam</button>
            </div>
            <div class="service-row">
                <div class="service-code">04 / PEDIATRICS<div style="margin-top:4px;color:var(--teal);">350 EGP</div></div>
                <div class="service-name">Child &amp; Adolescent Care</div>
                <div class="service-desc">Developmental wellness checks, immunization schedules, and acute pediatric consultations in a calm clinical setting.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Al-Sharqia Outpatient &bull; Floor 1</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Pediatrics">Book Exam</button>
            </div>
            <div class="service-row">
                <div class="service-code">05 / RADIOLOGY<div style="margin-top:4px;color:var(--teal);">300–1,800 EGP</div></div>
                <div class="service-name">Diagnostic Imaging &amp; PACS</div>
                <div class="service-desc">Digital X-Ray, 3T MRI, multi-slice CT, and Doppler ultrasound with consultant radiologist sign-off.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Main Medical Center &bull; Ground</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Radiology">Book Exam</button>
            </div>
            <div class="service-row">
                <div class="service-code">06 / LABORATORY<div style="margin-top:4px;color:var(--teal);">150–900 EGP</div></div>
                <div class="service-name">Clinical Pathology Lab</div>
                <div class="service-desc">Automated hematology, lipid panels, HbA1c, renal/hepatic profiles, and strict two-step result authorization.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Main Medical Center &bull; Ground</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Laboratory">Book Exam</button>
            </div>
            <div class="service-row">
                <div class="service-code">07 / PHARMACY<div style="margin-top:4px;color:var(--teal);">Rx Verified</div></div>
                <div class="service-name">In-House Clinical Dispensary</div>
                <div class="service-desc">Direct clinician-to-pharmacist e-prescriptions with batch tracking, allergy screening, and refill management.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Main Medical Center &bull; Lobby</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Pharmacy">Book Exam</button>
            </div>
            <div class="service-row">
                <div class="service-code">08 / ADMISSIONS<div style="margin-top:4px;color:var(--teal);">Ward Schedule</div></div>
                <div class="service-name">Inpatient Wards &amp; ICU</div>
                <div class="service-desc">24/7 monitored critical care, private recovery suites, and single-patient active bed integrity management.<div style="font-size:11.5px;color:var(--slate-light);margin-top:4px;">Main Medical Center &bull; Floors 4–6</div></div>
                <button type="button" class="btn btn-navy btn-sm" data-book-dept="Admissions">Book Exam</button>
            </div>
        </div>
    </div>
</section>
