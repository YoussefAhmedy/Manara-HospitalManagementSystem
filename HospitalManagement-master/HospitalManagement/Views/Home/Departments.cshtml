@using Hospital.BLL.ModelVM
@model MainVm
@{
    ViewData["Title"] = "Clinical Departments & Specialist Units";
    ViewData["Description"] = "Explore all 8 clinical departments at MANARA Medical Complex, diagnostic capabilities, and attending specialists.";
}

<section class="services-band" style="padding-top:48px;padding-bottom:76px;">
    <div class="container">
        <span class="pill-tag">Departments-First Directory</span>
        <h1 class="serif-display services-heading" style="margin-bottom:14px;">Our Eight Specialized Medical Departments</h1>
        <p style="color:var(--slate);max-width:720px;margin-bottom:28px;">
            Explore what each department treats, its advanced diagnostic capabilities, pavilion location, and the dedicated consultant specialists serving each discipline.
        </p>

        <div class="dept-showcase-grid">
            @foreach (var dept in Model.Departments)
            {
                <article class="dept-card">
                    <div class="dept-card-top">
                        <div>
                            <span class="service-code">@dept.Code &bull; @(dept.FloorLocation ?? "Main Pavilion")</span>
                            <h2 class="serif-display" style="font-size:24px;margin-top:6px;">@dept.Name</h2>
                        </div>
                        <a class="btn btn-outline btn-xs" asp-controller="Home" asp-action="Doctors" asp-route-dept="@dept.Name" style="text-decoration:none;">Filter Doctors</a>
                    </div>

                    <p style="font-size:13px;color:var(--slate);line-height:1.6;">
                        @(dept.Description ?? "Integrated specialist consultations, diagnostics, and coordinated continuity of care.")
                    </p>

                    @if (!string.IsNullOrWhiteSpace(dept.Capabilities))
                    {
                        <div class="dept-cap-pills">
                            @foreach (var cap in dept.Capabilities.Split('·', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <span class="dept-cap-pill">@cap</span>
                            }
                        </div>
                    }

                    <div class="dept-doc-chips">
                        <div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--slate-light);">
                            Attending Specialists (@dept.Doctors.Count)
                        </div>
                        @foreach (var doc in dept.Doctors)
                        {
                            var isFollowUp = Model.FollowUpEligibleDoctorIds.Contains(doc.Id);
                            var imgFile = string.IsNullOrWhiteSpace(doc.Image) ? "doc-salma.jpg" : doc.Image;
                            <div class="dept-doc-chip">
                                <img src="@Url.Content("~/images/doctors/" + imgFile)" alt="Dr. @doc.FirstName @doc.LastName" class="dept-doc-thumb" />
                                <div style="flex:1;min-width:0;">
                                    <div style="font-weight:700;font-size:13px;color:var(--navy);">Dr. @doc.FirstName @doc.LastName</div>
                                    <div style="font-size:11.5px;color:var(--slate);">@doc.Title &bull; @doc.Rating.ToString("0.0") ★ &bull; @doc.SessionPrice.ToString("0") EGP</div>
                                </div>
                                <button type="button" class="btn btn-navy btn-xs"
                                        data-book-dept="@dept.Name"
                                        data-book-doc="Dr. @doc.FirstName @doc.LastName"
                                        data-book-doc-id="@doc.Id"
                                        data-book-fee="@doc.SessionPrice.ToString("0")"
                                        data-book-followup="@doc.FollowUpFee.ToString("0")">
                                    @(isFollowUp ? $"Follow-Up ({doc.FollowUpFee:0} EGP)" : "Book")
                                </button>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>
    </div>
</section>
