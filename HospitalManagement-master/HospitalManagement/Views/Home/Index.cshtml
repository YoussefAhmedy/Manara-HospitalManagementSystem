@using Hospital.BLL.Helpers
@using Hospital.BLL.ModelVM
@model MainVm
@{
    ViewData["Title"] = "Luxury Clinical Hospital & Enterprise Care Platform";
    ViewData["Description"] = "MANARA — Serene, human-centered luxury clinical hospital and enterprise healthcare platform.";
}

<!-- MANARA Hero Section -->
<section class="manara-hero" style="background-image:url('@Url.Content("~/assets/manara/hero-corridor.jpg")');">
    <h1 class="serif-display hero-headline">Your Journey To<br />Wellness Begins Here</h1>
    <button type="button" class="hero-center-play" data-book-modal="true" title="Book Appointment" aria-label="Book Appointment">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>
    </button>
    <div>
        <p class="hero-bottom-copy">
            From specialist consultations and PACS diagnostic imaging to signed examination reports and digital prescriptions — unified in one serene clinical platform.
        </p>
        <div class="hero-cta-row">
            <button type="button" class="btn btn-navy" data-book-modal="true">Book Appointment</button>
            <a class="btn btn-outline" style="background:rgba(255,255,255,0.88);text-decoration:none;" asp-controller="Account" asp-action="LogIn">Sign In to Portal</a>
        </div>
    </div>
</section>

<!-- Mission Statement Band -->
<section class="mission-band">
    <div class="container">
        <div class="mission-emblem">
            <partial name="_ManaraLogo" model="54" />
        </div>
        <h2 class="serif-display mission-title">
            With our extensive network of clinical departments &amp; insurance partnerships, we strive to make quality healthcare accessible to everyone.
        </h2>
        <a class="pill-tag" style="cursor:pointer;text-decoration:none;" asp-controller="Account" asp-action="LogIn">Explore 8 Role Portals</a>
    </div>
</section>

<!-- Alternating Editorial Blocks -->
<section class="editorial-band">
    <div class="container">
        <div class="editorial-row">
            <div class="editorial-photo-wrap">
                <img src="@Url.Content("~/assets/manara/doc-karim.jpg")" alt="MANARA attending physician" class="editorial-photo" />
                <div class="navy-overlap-card">
                    <div style="color:var(--teal-soft);">
                        <partial name="_ManaraLogo" model="28" />
                    </div>
                    <div class="navy-overlap-title">A New Standard In Clinical Care</div>
                    <div class="navy-overlap-sub">Live EMR &bull; Radiology PACS &bull; Verified Lab Gate</div>
                </div>
            </div>
            <div>
                <span class="pill-tag">Our Services</span>
                <h2 class="serif-display editorial-heading">We Offer Unparalleled Healthcare Excellence With Manara</h2>
                <p style="color:var(--slate);font-size:13.5px;">
                    Every department at Manara Hospital is connected to a single audited clinical record — ensuring doctors, radiologists, pharmacists, and patients work from verified clinical truth.
                </p>
                <div class="editorial-subgrid">
                    <div>
                        <h4>Tailored Clinical Services</h4>
                        <p>Conflict-checked outpatient booking, structured vitals, immutable signed reports, and instant follow-up scheduling.</p>
                    </div>
                    <div>
                        <h4>Role-Based Hospital Suite</h4>
                        <p>Dedicated detached workspaces for Managers, Doctors, Patients, Reception, Lab, Radiology, Pharmacy, and Billing.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="editorial-row">
            <div>
                <span class="pill-tag">Our Heritage</span>
                <h2 class="serif-display editorial-heading">Decades Of Dedication: Our Storied Journey In Healthcare Excellence</h2>
                <p style="color:var(--slate);font-size:13.5px;margin-bottom:22px;">
                    Built directly around the architecture of Manara Enterprise Care, uniting outpatient care, inpatient bed management, laboratory verification, and transparent billing under least-privilege RBAC security.
                </p>
                <a class="btn btn-navy" asp-controller="Account" asp-action="LogIn" style="text-decoration:none;">Access Clinical Portals</a>
            </div>
            <div class="editorial-photo-wrap right-align">
                <img src="@Url.Content("~/assets/manara/consult-atrium.jpg")" alt="Senior physician consulting in hospital atrium" class="editorial-photo" />
                <div class="navy-overlap-card">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
                    <div class="navy-overlap-title">Committed To Patient Safety</div>
                    <div class="navy-overlap-sub">Signed Clinical Notes &bull; Full Audit Trail</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Hairline-Divided Services List -->
<section class="services-band">
    <div class="container">
        <span class="pill-tag">Departments &amp; Services</span>
        <h2 class="serif-display services-heading">A Seamless Service At Your Fingertips: Book An Appointment Today For The Best Care In The Industry</h2>
        <div>
            <div class="service-row">
                <div class="service-code">01 / CARDIOLOGY</div>
                <div class="service-name">Heart &amp; Vascular Care</div>
                <div class="service-desc">Comprehensive cardiac diagnostics including ECG, echocardiography, hypertension management, and preventive cardiology.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Cardiology">Book &rarr;</button>
            </div>
            <div class="service-row">
                <div class="service-code">02 / INTERNAL MEDICINE</div>
                <div class="service-name">Primary &amp; Chronic Care</div>
                <div class="service-desc">Holistic adult medicine covering metabolic screening, diabetes, thyroid care, and executive health assessments.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Internal Medicine">Book &rarr;</button>
            </div>
            <div class="service-row">
                <div class="service-code">03 / ORTHOPEDICS</div>
                <div class="service-name">Joint &amp; Spine Surgery</div>
                <div class="service-desc">Sports injury recovery, minimally invasive arthroscopy, fracture stabilization, and post-operative rehabilitation.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Orthopedics">Book &rarr;</button>
            </div>
            <div class="service-row">
                <div class="service-code">04 / PEDIATRICS</div>
                <div class="service-name">Child &amp; Adolescent Care</div>
                <div class="service-desc">Developmental wellness checks, immunization schedules, and acute pediatric consultations in a calm clinical setting.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Pediatrics">Book &rarr;</button>
            </div>
            <div class="service-row">
                <div class="service-code">05 / RADIOLOGY</div>
                <div class="service-name">Diagnostic Imaging &amp; PACS</div>
                <div class="service-desc">Digital X-Ray, 3T MRI, multi-slice CT, and Doppler ultrasound with consultant radiologist sign-off.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Radiology">Book &rarr;</button>
            </div>
            <div class="service-row">
                <div class="service-code">06 / LABORATORY</div>
                <div class="service-name">Clinical Pathology Lab</div>
                <div class="service-desc">Automated hematology, lipid panels, HbA1c, renal/hepatic profiles, and strict two-step result authorization.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Laboratory">Book &rarr;</button>
            </div>
            <div class="service-row">
                <div class="service-code">07 / PHARMACY</div>
                <div class="service-name">In-House Clinical Dispensary</div>
                <div class="service-desc">Direct clinician-to-pharmacist e-prescriptions with batch tracking, allergy screening, and refill management.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Pharmacy">Book &rarr;</button>
            </div>
            <div class="service-row">
                <div class="service-code">08 / ADMISSIONS</div>
                <div class="service-name">Inpatient Wards &amp; ICU</div>
                <div class="service-desc">24/7 monitored critical care, private recovery suites, and single-patient active bed integrity management.</div>
                <button type="button" class="btn btn-outline btn-sm" data-book-dept="Admissions">Book &rarr;</button>
            </div>
        </div>
    </div>
</section>

<!-- Specialists Editorial Grid -->
<section class="doctors-band">
    <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:16px;flex-wrap:wrap;">
            <div>
                <span class="pill-tag">Medical Faculty</span>
                <h2 class="serif-display" style="font-size:34px;margin-top:12px;">Board-Certified Specialists</h2>
            </div>
            <a class="btn btn-outline btn-sm" asp-controller="Home" asp-action="Doctors" style="text-decoration:none;">View Full Faculty</a>
        </div>
        <div class="doc-grid">
            <div class="doc-card">
                <img src="@Url.Content("~/assets/manara/doc-salma.jpg")" alt="Dr. Salma El-Sayed" class="doc-img" />
                <div class="doc-info">
                    <div class="doc-spec">Cardiology</div>
                    <div class="doc-name">Dr. Salma El-Sayed</div>
                    <div class="doc-meta">Senior Consultant Cardiologist</div>
                    <div class="doc-meta tabular" style="margin-bottom:12px;">MD, FESC &bull; 14 Yrs &bull; 450 EGP</div>
                    <button type="button" class="btn btn-navy btn-sm" style="margin-top:auto;width:100%;" data-book-dept="Cardiology" data-book-doc="Dr. Salma El-Sayed">Book Consultation</button>
                </div>
            </div>
            <div class="doc-card">
                <img src="@Url.Content("~/assets/manara/doc-karim.jpg")" alt="Dr. Karim Mansour" class="doc-img" />
                <div class="doc-info">
                    <div class="doc-spec">Internal Medicine</div>
                    <div class="doc-name">Dr. Karim Mansour</div>
                    <div class="doc-meta">Head of Internal Medicine</div>
                    <div class="doc-meta tabular" style="margin-bottom:12px;">MD, MRCP &bull; 16 Yrs &bull; 350 EGP</div>
                    <button type="button" class="btn btn-navy btn-sm" style="margin-top:auto;width:100%;" data-book-dept="Internal Medicine" data-book-doc="Dr. Karim Mansour">Book Consultation</button>
                </div>
            </div>
            <div class="doc-card">
                <img src="@Url.Content("~/assets/manara/doc-tarek.jpg")" alt="Dr. Tarek Nabil" class="doc-img" />
                <div class="doc-info">
                    <div class="doc-spec">Orthopedics</div>
                    <div class="doc-name">Dr. Tarek Nabil</div>
                    <div class="doc-meta">Consultant Orthopedic Surgeon</div>
                    <div class="doc-meta tabular" style="margin-bottom:12px;">MD, FRCS &bull; 18 Yrs &bull; 400 EGP</div>
                    <button type="button" class="btn btn-navy btn-sm" style="margin-top:auto;width:100%;" data-book-dept="Orthopedics" data-book-doc="Dr. Tarek Nabil">Book Consultation</button>
                </div>
            </div>
            <div class="doc-card">
                <img src="@Url.Content("~/assets/manara/doc-nadia.jpg")" alt="Dr. Nadia Farouk" class="doc-img" />
                <div class="doc-info">
                    <div class="doc-spec">Pediatrics</div>
                    <div class="doc-name">Dr. Nadia Farouk</div>
                    <div class="doc-meta">Specialist Pediatrician</div>
                    <div class="doc-meta tabular" style="margin-bottom:12px;">MSc Board Cert &bull; 9 Yrs &bull; 350 EGP</div>
                    <button type="button" class="btn btn-navy btn-sm" style="margin-top:auto;width:100%;" data-book-dept="Pediatrics" data-book-doc="Dr. Nadia Farouk">Book Consultation</button>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Testimonials Band -->
<section class="testimonials-band">
    <div class="container">
        <div class="testimonials-box">
            <span class="pill-tag">Testimonials</span>
            <h2 class="serif-display" style="font-size:34px;max-width:620px;margin:14px auto 0;">We Invite You To Listen To What Our Patients Have To Say About Manara</h2>
            <div class="testimonials-grid">
                <div>
                    <div class="quote-author">Ahmed Hassan</div>
                    <p class="quote-text">&ldquo;Booking my cardiology follow-up, reviewing my Chest X-Ray in the portal, and downloading my signed examination report and prescription took less than two minutes.&rdquo;</p>
                    <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                </div>
                <div>
                    <div class="quote-author">Fatima Mahmoud</div>
                    <p class="quote-text">&ldquo;The transparency is unmatched — you can reschedule or cancel visits effortlessly, and laboratory results only appear as final once verified by the specialist.&rdquo;</p>
                    <div class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
                </div>
            </div>
            <a class="pill-tag" style="cursor:pointer;text-decoration:none;" asp-controller="Account" asp-action="LogIn" asp-route-role="ACC-PATIENT">Load Patient Portal Credentials</a>
        </div>
    </div>
</section>
