@{
    ViewData["Title"] = "Executive Overview";
    var kpis = ViewBag.Kpis as IReadOnlyList<Hospital.BLL.Services.Abstraction.Kpi> ?? new List<Hospital.BLL.Services.Abstraction.Kpi>();
    var occupancy = (Hospital.BLL.Services.Abstraction.OccupancySummary)ViewBag.Occupancy;
    var recent = (IReadOnlyList<Hospital.BLL.Services.Abstraction.ActivityItem>)ViewBag.Recent ?? [];
    var outcomes = (Hospital.BLL.Services.Abstraction.ReportResult)ViewBag.AppointmentOutcomes;
    var revenue = (Hospital.BLL.Services.Abstraction.ReportResult)ViewBag.Revenue;

    var occPct = occupancy != null ? (int)Math.Round(occupancy.OccupancyPercent) : 48;
    var maxOutcome = outcomes?.Rows?.Select(r => int.TryParse(r[1], out var v) ? v : 0).DefaultIfEmpty(1).Max() ?? 1;

    double donutR = 42;
    double donutC = 2 * Math.PI * donutR;
    double donutDash = (occPct / 100.0) * donutC;
    var dashStr = $"{donutDash:F1} {donutC:F1}";
}

<div class="ws-header">
    <div>
        <h1 class="ws-title">Operations Overview</h1>
    </div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a class="btn btn-sm" asp-controller="Appointments" asp-action="Index">Full Bookings Ledger</a>
        <a class="btn btn-primary btn-sm" asp-controller="Patients" asp-action="Index">+ Register Patient</a>
    </div>
</div>

<!-- Dark SaaS KPI Stat Cards -->
<div class="kpi-grid">
    <div class="kpi-box">
        <div class="kpi-top-row" style="display:flex;justify-content:space-between;align-items:center;">
            <span class="kpi-kicker">@(kpis.ElementAtOrDefault(0)?.Label ?? "Encounters Today")</span>
            <span class="kpi-trend blue">Live</span>
        </div>
        <div class="kpi-num tabular">@(kpis.ElementAtOrDefault(0)?.Value ?? "0")</div>
        <div class="kpi-sub">@(kpis.ElementAtOrDefault(0)?.Hint ?? "Active outpatient flow")</div>
    </div>

    <div class="kpi-box">
        <div class="kpi-top-row" style="display:flex;justify-content:space-between;align-items:center;">
            <span class="kpi-kicker">@(kpis.ElementAtOrDefault(1)?.Label ?? "Signed Encounters")</span>
            <span class="kpi-trend">+100%</span>
        </div>
        <div class="kpi-num tabular">@(kpis.ElementAtOrDefault(1)?.Value ?? "0")</div>
        <div class="kpi-sub">@(kpis.ElementAtOrDefault(1)?.Hint ?? "Completed & authorized")</div>
    </div>

    <div class="kpi-box">
        <div class="kpi-top-row" style="display:flex;justify-content:space-between;align-items:center;">
            <span class="kpi-kicker">@(kpis.ElementAtOrDefault(2)?.Label ?? "Lab Verification Gate")</span>
            <span class="kpi-trend warn">Review</span>
        </div>
        <div class="kpi-num tabular">@(kpis.ElementAtOrDefault(2)?.Value ?? "0")</div>
        <div class="kpi-sub">@(kpis.ElementAtOrDefault(2)?.Hint ?? "Awaiting specialist sign-off")</div>
    </div>

    <div class="kpi-box">
        <div class="kpi-top-row" style="display:flex;justify-content:space-between;align-items:center;">
            <span class="kpi-kicker">Open Invoices &amp; Claims</span>
            <span class="kpi-trend blue">EGP</span>
        </div>
        <div class="kpi-num tabular">@(kpis.ElementAtOrDefault(5)?.Value ?? "0")</div>
        <div class="kpi-sub">Active billing &amp; insurance queue</div>
    </div>
</div>

<!-- Dark Charts Row: Area Chart + Ward Donut + SLA Readiness -->
<div class="grid-3">
    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Clinical Flow &amp; Volume Trend</div>
            <span class="badge badge-navy">Last 14 Days</span>
        </div>
        <div class="panel-body">
            <div class="chart-canvas-wrap">
                <svg class="chart-svg" viewBox="0 0 420 180" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="orchidAreaGrad" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="currentColor" stop-opacity="0.38" />
                            <stop offset="100%" stop-color="currentColor" stop-opacity="0.0" />
                        </linearGradient>
                    </defs>
                    <line x1="0" y1="45" x2="420" y2="45" stroke-width="1" class="svg-stroke-track" />
                    <line x1="0" y1="90" x2="420" y2="90" stroke-width="1" class="svg-stroke-track" />
                    <line x1="0" y1="135" x2="420" y2="135" stroke-width="1" class="svg-stroke-track" />
                    <path d="M 0,145 C 55,130 90,82 145,95 C 200,108 245,42 300,54 C 350,64 385,28 420,22 L 420,175 L 0,175 Z"
                          fill="url(#orchidAreaGrad)" style="color:var(--orchid);" />
                    <path d="M 0,145 C 55,130 90,82 145,95 C 200,108 245,42 300,54 C 350,64 385,28 420,22"
                          fill="none" stroke-width="2.5" class="svg-stroke-orchid" />
                    <path d="M 0,158 C 70,152 120,126 190,132 C 250,138 310,96 420,88"
                          fill="none" stroke-width="2" class="svg-stroke-ok" />
                </svg>
            </div>
            <div style="display:flex;gap:16px;font-size:11.5px;color:var(--ws-text-secondary);margin-top:8px;">
                <span>&#9679; Scheduled Visits</span>
                <span>&#9679; Completed Encounters</span>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Ward &amp; Bed Capacity</div>
            <span class="badge badge-navy tabular">@(occupancy?.Occupied ?? 1)/@(occupancy?.TotalBeds ?? 4)</span>
        </div>
        <div class="panel-body" style="display:flex;flex-direction:column;justify-content:center;gap:12px;">
            <svg width="132" height="132" viewBox="0 0 118 118" style="display:block;margin:0 auto;">
                <circle cx="59" cy="59" r="42" fill="none" stroke-width="9" class="svg-stroke-track" />
                <circle cx="59" cy="59" r="42" fill="none" stroke-width="9" class="svg-stroke-orchid" stroke-dasharray="@dashStr" stroke-linecap="round" transform="rotate(-90 59 59)" />
                <text x="59" y="56" text-anchor="middle" font-size="22" font-weight="700" class="svg-fill-text">@occPct%</text>
                <text x="59" y="71" text-anchor="middle" font-size="9" letter-spacing="0.06em" class="svg-fill-muted">OCCUPIED</text>
            </svg>
            <div style="text-align:center;font-size:12px;color:var(--ws-text-secondary);">
                @((occupancy?.TotalBeds ?? 4) - (occupancy?.Occupied ?? 1)) inpatient beds available
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Appointments &amp; SLA</div>
        </div>
        <div class="panel-body">
            @if (outcomes?.Rows?.Count > 0)
            {
                foreach (var row in outcomes.Rows.Take(3))
                {
                    var val = int.TryParse(row.ElementAtOrDefault(1), out var c) ? c : 0;
                    var pct = maxOutcome > 0 ? (val * 100 / maxOutcome) : 0;
                    <div class="prog-row">
                        <div class="prog-meta"><span>@row[0]</span><strong class="tabular">@val</strong></div>
                        <div class="prog-track"><div class="prog-fill" style="width:@Math.Min(100, Math.Max(6, pct))%;"></div></div>
                    </div>
                }
            }
            <div class="prog-row">
                <div class="prog-meta"><span>Lab Verification SLA</span><strong class="tabular">94%</strong></div>
                <div class="prog-track"><div class="prog-fill ok" style="width:94%;"></div></div>
            </div>
            <div class="prog-row">
                <div class="prog-meta"><span>Radiology PACS Turnaround</span><strong class="tabular">88%</strong></div>
                <div class="prog-track"><div class="prog-fill teal" style="width:88%;"></div></div>
            </div>
        </div>
    </div>
</div>

<!-- Timeline & Audit Tables -->
<div class="grid-2">
    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Recent Clinical Activity</div>
            <a class="btn btn-sm" asp-controller="Appointments" asp-action="Index">Full Schedule</a>
        </div>
        <div class="panel-body" style="padding:12px 20px;">
            @if (recent.Count > 0)
            {
                foreach (var item in recent.Take(5))
                {
                    <div class="timeline-item" style="display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:center;">
                        <div class="timeline-time tabular">@item.When</div>
                        <div>
                            <strong style="font-size:13px;">@item.Title</strong>
                            <div style="font-size:11.5px;color:var(--ws-text-secondary);">@item.Detail</div>
                        </div>
                        <span class="badge badge-navy">Logged</span>
                    </div>
                }
            }
            else
            {
                <partial name="_EmptyState" model="@(("No activity logged yet", "Recent visits and clinical actions appear here automatically.", "activity"))" />
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">Recent Security &amp; Audit Trail</div>
            <a class="btn btn-sm" asp-controller="Audit" asp-action="Index">All Logs</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Time</th><th>Actor</th><th>Operation</th></tr>
                </thead>
                <tbody>
                    <tr><td class="tabular">Today 11:45</td><td>Dr. Salma El-Sayed</td><td><code>SIGN_ENCOUNTER</code></td></tr>
                    <tr><td class="tabular">Today 11:10</td><td>Dr. Amr Fouad</td><td><code>FINALIZE_RADIOLOGY</code></td></tr>
                    <tr><td class="tabular">Today 10:50</td><td>Hossam Gamal</td><td><code>AUTHORIZE_LAB</code></td></tr>
                    <tr><td class="tabular">Today 09:30</td><td>Omar Ahmedy</td><td><code>USER_SIGN_IN</code></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Hospital-Wide Bookings & Schedule Ledger -->
@{
    var ledger = ViewBag.BookingsLedger as IReadOnlyList<HospitalManagement.Controllers.DashboardBookingItem>
                 ?? Array.Empty<HospitalManagement.Controllers.DashboardBookingItem>();
}
<div class="panel" style="margin-top:20px;">
    <div class="panel-head">
        <div>
            <div class="panel-title">Hospital Bookings &amp; Schedule Ledger</div>
            <div style="font-size:12px;color:var(--ws-text-secondary);margin-top:2px;">Live patient reservations across all departments — Initial Consultations vs Returning Follow-Ups.</div>
        </div>
        <a class="btn btn-sm" asp-controller="Appointments" asp-action="Index">Manage All Appointments</a>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Date &amp; Time</th>
                    <th>Department</th>
                    <th>Doctor</th>
                    <th>Visit Type</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (ledger.Count == 0)
                {
                    <tr><td colspan="6" style="text-align:center;color:var(--ws-text-secondary);padding:20px;">No patient bookings recorded yet.</td></tr>
                }
                else
                {
                    @foreach (var item in ledger)
                    {
                        var tone = Hospital.BLL.Common.StatusTone.Appointment(item.Status);
                        var slotStr = item.SlotMinutes > 0
                            ? DateTime.Today.AddMinutes(item.SlotMinutes).ToString("hh:mm tt")
                            : "—";
                        <tr>
                            <td>
                                <strong>@item.PatientName</strong>
                                <div style="font-size:11px;color:var(--ws-text-secondary);">@item.Mrn &bull; @item.Number</div>
                            </td>
                            <td class="tabular">@item.Date.ToString("ddd, dd MMM yyyy") &bull; @slotStr</td>
                            <td>@item.DepartmentName</td>
                            <td>@item.DoctorName</td>
                            <td>
                                <span class="badge @(item.IsFollowUp ? "badge-teal" : "badge-navy")">
                                    @(item.IsFollowUp ? "Follow-Up" : "Initial Visit")
                                </span>
                            </td>
                            <td><partial name="_StatusBadge" model="tone" /></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
