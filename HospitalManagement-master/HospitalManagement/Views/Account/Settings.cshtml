@using Hospital.BLL.Helpers
@using Hospital.BLL.ModelVM
@model SettingsVm
@{
    Layout = Model.UseWorkspaceLayout ? "_WorkspaceLayout" : "_Layout";
    ViewData["Title"] = "Settings & Preferences";
    ViewData["Subtitle"] = "Account security, notifications, and workspace display preferences.";
    var ctxParam = Model.UseWorkspaceLayout ? "ws" : null;
    bool isPatientOnly = User.IsInRole(nameof(Role.Patient)) &&
                         !User.IsInRole(nameof(Role.Admin)) &&
                         !User.IsInRole(nameof(Role.HospitalAdmin)) &&
                         !User.IsInRole(nameof(Role.SuperAdmin)) &&
                         !User.IsInRole(nameof(Role.Management)) &&
                         !User.IsInRole(nameof(Role.Doctor));
}

@if (!Model.UseWorkspaceLayout)
{
    @:<section class="manara-settings-light"><div class="container">
}

<div class="ws-header manara-settings-head">
    <div>
        <h1 class="ws-title">Settings</h1>
    </div>
    <div class="action-row">
        @if (!Model.UseWorkspaceLayout)
        {
            <a class="btn-outline" asp-controller="Updates" asp-action="Index">Open My Updates</a>
            @if (!isPatientOnly)
            {
                <a class="btn-primary" asp-controller="Dashboard" asp-action="Index">Open Workspace</a>
            }
        }
        else
        {
            <a class="btn btn-sm" asp-controller="Account" asp-action="Profile" asp-route-ctx="ws">Edit Full Profile</a>
        }
    </div>
</div>

@if (TempData["StatusMessage"] is string okMsg)
{
    <div class="status-message" role="status">@okMsg</div>
}
@if (TempData["ErrorMessage"] is string errMsg)
{
    <div class="validation-summary-errors" role="alert">@errMsg</div>
}

<div class="grid-2 manara-settings-grid">
    <section class="panel" aria-labelledby="profile-overview-heading">
        <div class="panel-head">
            <h2 class="panel-title" id="profile-overview-heading">Profile Overview</h2>
            <span class="badge badge-navy">@string.Join(", ", Model.Roles)</span>
        </div>
        <div class="panel-body stack">
            <div class="settings-identity-row">
                <img class="avatar-medium" src="@Url.Action("ProfileImage", "Account")" alt="@Model.Profile.FirstName @Model.Profile.LastName" />
                <div>
                    <div class="settings-identity-name">@Model.Profile.FirstName @Model.Profile.LastName</div>
                    <div class="settings-identity-email">@Model.Profile.Email</div>
                </div>
            </div>
            <div class="dl">
                <dt>Email Address</dt><dd>@Model.Profile.Email</dd>
                <dt>Phone Number</dt><dd>@(Model.Profile.PhoneNumber ?? "Not provided")</dd>
                <dt>Role Access</dt><dd>@string.Join(", ", Model.Roles)</dd>
            </div>
            <div>
                <a class="btn btn-sm" asp-controller="Account" asp-action="Profile" asp-route-ctx="@ctxParam">Update Contact &amp; Avatar</a>
            </div>
        </div>
    </section>

    <section class="panel" aria-labelledby="security-heading">
        <div class="panel-head">
            <h2 class="panel-title" id="security-heading">Password &amp; Security</h2>
            <span class="pill-tag">Protected</span>
        </div>
        <div class="panel-body">
            <form asp-controller="Account" asp-action="ChangePassword" asp-route-ctx="@ctxParam" method="post" class="form-grid">
                <div class="form-field full">
                    <label class="form-label" for="curPw">Current Password</label>
                    <input class="input" id="curPw" type="password" name="CurrentPassword" required autocomplete="current-password" />
                </div>
                <div class="form-field">
                    <label class="form-label" for="newPw">New Password</label>
                    <input class="input" id="newPw" type="password" name="NewPassword" required autocomplete="new-password" />
                </div>
                <div class="form-field">
                    <label class="form-label" for="confPw">Confirm New Password</label>
                    <input class="input" id="confPw" type="password" name="ConfirmNewPassword" required autocomplete="new-password" />
                </div>
                <div class="form-field full">
                    <button type="submit" class="btn btn-primary">Update Password</button>
                </div>
            </form>
        </div>
    </section>

    <section class="panel span-full" aria-labelledby="pref-heading">
        <div class="panel-head">
            <h2 class="panel-title" id="pref-heading">Notifications &amp; Interface Accessibility</h2>
            <span class="pill-tag">Synced to Account</span>
        </div>
        <div class="panel-body">
            <form asp-controller="Account" asp-action="SavePreferences" asp-route-ctx="@ctxParam" method="post" class="settings-pref-form">
                <div class="grid-2">
                    <div class="stack">
                        <div class="care-tile">
                            <span class="care-tile__icon"><partial name="_Icon" model="@("lab")" /></span>
                            <div class="care-tile__text">
                                <div class="care-tile__title">Lab &amp; Radiology Alerts</div>
                                <div class="care-tile__sub">Notify me via inbox &amp; email when verified results are released.</div>
                            </div>
                            <input class="settings-toggle" type="checkbox" asp-for="EmailNotifyLabs" />
                        </div>

                        <div class="care-tile">
                            <span class="care-tile__icon"><partial name="_Icon" model="@("pharmacy")" /></span>
                            <div class="care-tile__text">
                                <div class="care-tile__title">Prescription Updates</div>
                                <div class="care-tile__sub">Receive medication instructions and pharmacy dispensing alerts.</div>
                            </div>
                            <input class="settings-toggle" type="checkbox" asp-for="EmailNotifyPrescriptions" />
                        </div>

                        <div class="care-tile">
                            <span class="care-tile__icon"><partial name="_Icon" model="@("calendar")" /></span>
                            <div class="care-tile__text">
                                <div class="care-tile__title">Appointment &amp; Follow-Up Reminders</div>
                                <div class="care-tile__sub">Send schedule confirmations and recommended follow-up reminders.</div>
                            </div>
                            <input class="settings-toggle" type="checkbox" asp-for="EmailNotifyAppointments" />
                        </div>

                        <div class="care-tile">
                            <span class="care-tile__icon"><partial name="_Icon" model="@("message")" /></span>
                            <div class="care-tile__text">
                                <div class="care-tile__title">Doctor Consultation Replies</div>
                                <div class="care-tile__sub">Alert me when an attending physician responds to my inquiry.</div>
                            </div>
                            <input class="settings-toggle" type="checkbox" asp-for="EmailNotifyReplies" />
                        </div>
                    </div>

                    <div class="stack">
                        <div class="care-tile care-tile--select">
                            <span class="care-tile__icon"><partial name="_Icon" model="@("eye")" /></span>
                            <div class="care-tile__text">
                                <div class="care-tile__title">Accessible Typography Scale</div>
                                <div class="care-tile__sub">Adjust reading scale across portals and clinical records.</div>
                            </div>
                            <select class="select settings-select" asp-for="UiFontSize" id="wsFontSizeSelect" aria-label="Typography size">
                                <option value="default">Standard (14px)</option>
                                <option value="large">Large Accessible (16.5px)</option>
                            </select>
                        </div>

                        <div class="care-tile care-tile--select">
                            <span class="care-tile__icon"><partial name="_Icon" model="@("dashboard")" /></span>
                            <div class="care-tile__text">
                                <div class="care-tile__title">Layout Spacing Density</div>
                                <div class="care-tile__sub">Switch between relaxed clinic cards and compact operational tables.</div>
                            </div>
                            <select class="select settings-select" asp-for="UiDensity" id="wsDensitySelect" aria-label="Layout density">
                                <option value="comfortable">Comfortable</option>
                                <option value="compact">Compact</option>
                            </select>
                        </div>

                        <div class="care-tile">
                            <span class="care-tile__icon"><partial name="_Icon" model="@("shield")" /></span>
                            <div class="care-tile__text">
                                <div class="care-tile__title">Reduced Motion Mode</div>
                                <div class="care-tile__sub">Disable subtle ambient transitions for maximum visual steadiness.</div>
                            </div>
                            <input class="settings-toggle" type="checkbox" asp-for="UiReducedMotion" id="wsReducedMotionToggle" />
                        </div>
                    </div>
                </div>

                <div class="settings-actions">
                    <button type="submit" class="btn btn-primary">Save Preferences</button>
                </div>
            </form>
        </div>
    </section>
</div>

@if (!Model.UseWorkspaceLayout)
{
    @:</div></section>
}
