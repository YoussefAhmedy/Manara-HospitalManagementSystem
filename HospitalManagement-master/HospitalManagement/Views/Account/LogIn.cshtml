@model Hospital.BLL.ModelVM.LogInViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["Description"] = "Sign in or create a patient account at MANARA Medical Complex.";
}

<section class="auth-dark-shell">
    <div class="auth-dark-card">
        <div class="auth-dark-brand">
            <div class="auth-dark-logo">
                <partial name="_ManaraLogo" model="26" />
                <span>MANARA</span>
            </div>
            <h1 class="auth-dark-title">Log in to your account</h1>
            <p class="auth-dark-sub">Access your medical care, appointments, or clinical workspace</p>
        </div>

        <div class="auth-tabs" role="tablist">
            <button type="button" class="auth-tab-btn active" id="tabLoginBtn" role="tab" aria-selected="true">Log In</button>
            <button type="button" class="auth-tab-btn" id="tabRegBtn" role="tab" aria-selected="false">Create Account</button>
        </div>

        @if (TempData["StatusMessage"] is string statusMsg)
        {
            <div class="notice notice--success" style="margin-bottom:16px;padding:10px 12px;border-radius:8px;font-size:12px;">
                <span>@statusMsg</span>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errMsg)
        {
            <div class="notice notice--warning" style="margin-bottom:16px;padding:10px 12px;border-radius:8px;font-size:12px;">
                <span>@errMsg</span>
            </div>
        }

        <!-- Sign In Form -->
        <div id="loginFormPane">
            <form asp-action="LogIn" asp-controller="Account" method="post" id="loginForm" class="form-grid">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="All" class="validation-summary-errors form-field full" role="alert" style="color:var(--danger);font-size:12px;"></div>

                <div class="form-field full">
                    <label class="form-label" asp-for="Email">Email</label>
                    <input class="auth-dark-input" asp-for="Email" id="loginEmailInput" type="email" placeholder="Email or username" autocomplete="username" inputmode="email" required value="" />
                    <span asp-validation-for="Email" class="field-validation-error" style="font-size:11.5px;"></span>
                </div>

                <div class="form-field full">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;">
                        <label class="form-label" asp-for="Password" style="margin:0;">Password</label>
                        <a asp-controller="Account" asp-action="ForgetPassword" style="font-size:11.5px;color:var(--slate-light);text-decoration:none;">Forgot password?</a>
                    </div>
                    <div class="pw-wrap">
                        <input class="auth-dark-input" asp-for="Password" id="loginPassInput" type="password" placeholder="Enter your password" autocomplete="current-password" required value="" style="padding-right:56px;" />
                        <button type="button" class="pw-toggle" id="togglePwBtn" style="color:var(--slate-light);">Show</button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error" style="font-size:11.5px;"></span>
                </div>

                <div class="form-field full" style="display:flex;align-items:center;gap:8px;margin-top:2px;">
                    <input type="checkbox" asp-for="RememberMe" id="rememberMeInput" />
                    <label for="rememberMeInput" style="font-size:12px;color:var(--slate-light);cursor:pointer;margin:0;">Keep me signed in</label>
                </div>

                <div class="form-field full" style="margin-top:6px;">
                    <button type="submit" class="auth-orchid-btn" id="submitLoginBtn">Log in</button>
                </div>

                @if (Model?.ExternalLogins?.Any(scheme => scheme.Name == "Google") == true)
                {
                    <div class="form-field full">
                        <div class="auth-or-divider">OR</div>
                        <a class="auth-oauth-btn" asp-controller="Account" asp-action="GoogleAuth" asp-route-returnUrl="@Model.ReturnUrl">
                            Continue with Google
                        </a>
                    </div>
                }
            </form>
        </div>

        <!-- Patient Registration Form -->
        <div id="registerFormPane" style="display:none;">
            <form asp-action="Register" asp-controller="Account" method="post" id="registerForm" class="form-grid">
                <div class="form-field">
                    <label class="form-label">First Name *</label>
                    <input class="auth-dark-input" name="FirstName" placeholder="e.g. Ahmed" required />
                </div>
                <div class="form-field">
                    <label class="form-label">Last Name *</label>
                    <input class="auth-dark-input" name="LastName" placeholder="e.g. Hassan" required />
                </div>
                <div class="form-field full">
                    <label class="form-label">Email Address *</label>
                    <input class="auth-dark-input" type="email" name="Email" placeholder="name@gmail.com" required />
                </div>
                <div class="form-field">
                    <label class="form-label">Phone Number *</label>
                    <input class="auth-dark-input" type="tel" name="PhoneNumber" placeholder="01012345678" required />
                </div>
                <div class="form-field">
                    <label class="form-label">Gender *</label>
                    <select class="auth-dark-select" name="Gender" required>
                        <option value="">Select</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div class="form-field full">
                    <label class="form-label">Date of Birth *</label>
                    <input class="auth-dark-input" type="date" name="DateOfBirth" value="1990-01-01" required />
                </div>
                <div class="form-field">
                    <label class="form-label">Password *</label>
                    <input class="auth-dark-input" type="password" name="Password" placeholder="Min. 6 characters" required />
                </div>
                <div class="form-field">
                    <label class="form-label">Confirm *</label>
                    <input class="auth-dark-input" type="password" name="ConfirmedPassword" placeholder="Repeat password" required />
                </div>
                <div class="form-field full" style="margin-top:6px;">
                    <button type="submit" class="auth-orchid-btn">Create Patient Account</button>
                </div>
                <div class="form-field full" style="text-align:center;margin-top:4px;">
                    <span style="font-size:11.5px;color:var(--slate-light);">Doctor or Staff accounts are provisioned by the Hospital Manager.</span>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
