@using Hospital.BLL.Helpers
@{
    ViewData["Title"] = "Restricted Area";
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isPatientOnly = isAuthenticated &&
                         User.IsInRole(nameof(Role.Patient)) &&
                         !User.IsInRole(nameof(Role.Admin)) &&
                         !User.IsInRole(nameof(Role.HospitalAdmin)) &&
                         !User.IsInRole(nameof(Role.SuperAdmin)) &&
                         !User.IsInRole(nameof(Role.Management)) &&
                         !User.IsInRole(nameof(Role.Doctor));
}

<section class="manara-status-section" aria-labelledby="denied-heading">
    <div class="container">
        <div class="manara-status-card">
            <div class="manara-status-icon">
                <partial name="_Icon" model="@("shield")" />
            </div>
            <h1 class="serif-display manara-status-title" id="denied-heading">This area is restricted to authorized staff</h1>
            <p class="manara-status-lead">
                @if (isPatientOnly)
                {
                    @:Patient accounts stay within the calm MANARA Sanctuary Portal. You can inspect your clinical updates, prescriptions, and appointments anytime below.
                }
                else
                {
                    @:Your current account permissions do not cover the requested operational route.
                }
            </p>
            <div class="manara-status-actions">
                <a class="btn btn-navy" asp-controller="Home" asp-action="Index">Go Back Home</a>
                @if (isAuthenticated)
                {
                    <a class="btn btn-outline" asp-controller="Updates" asp-action="Index">View My Updates</a>
                }
                else
                {
                    <a class="btn btn-outline" asp-controller="Account" asp-action="LogIn">Sign In</a>
                }
            </div>
        </div>
    </div>
</section>
